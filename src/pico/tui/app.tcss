#conversation {
    height: 1fr;
    scrollbar-size-vertical: 0;
}
#footer {
    dock: bottom;
    height: auto;
}
#input-bar {
    height: auto;
}
#stats-strip {
    height: 1;
    padding: 0 1;
}
#stats-strip Static {
    width: auto;
    height: 1;
}
.stats-label {
    padding: 0 1 0 0;
}
.stats-label, .stats-separator {
    color: $foreground 40%;
}
#user-input {
    height: auto;
    max-height: 10;
    background: $background;
    border: none;
    padding: 0;
}
#user-input:focus {
    background: $background;
    border: none;
}
Rule {
    margin: 0;
}
#command-menu {
    height: auto;
    background: $background;
}
